# Database (WAMP host by default; use the localdb compose profile on Linux)
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=ashen_app
DB_PASSWORD=change-me
DB_NAME=ashen_realms
DB_POOL_SIZE=10

# Auth
JWT_SECRET= "secret_key"

# API
CORS_ORIGINS=http://localhost:8080

# Demo character generator endpoint (POST /demo/generate)
DEMO_ENABLED=true
